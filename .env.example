# ─────────────────────────────────────────────────────────────
# CHOLO BONDHU — Environment Variables Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or real secrets to version control.

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_api_key_here
GOOGLE_MAPS_SERVER_API_KEY=your_server_api_key_here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authoritative Database (MongoDB Atlas / Replica Set)
# Required for production cross-device synchronization.
# If omitted during local testing, an in-memory test repository adapter is used automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cholobondhu?retryWrites=true&w=majority

# Session & Token Security Secret (Min 32 characters)
AUTH_SECRET=generate_with_openssl_rand_base64_32

# External SMS / OTP Gateway (Optional for production live SMS delivery)
# Supported providers: Fast2SMS, MSG91, Twilio.
# When not set, the app runs in safe development mode logging OTPs to server terminal.
SMS_PROVIDER=fast2sms
SMS_PROVIDER_API_KEY=your_sms_gateway_api_key
SMS_PROVIDER_SENDER_ID=CHLBDH
